.hud-root {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}
.player-hud-panel { flex-shrink: 0; flex-direction: column; }
.player-surface { flex-shrink: 0; border-width: 1px; border-radius: 14px; }
.gameplay-body { position: relative; }
.gameplay-group { position: absolute; }
.gameplay-controls { position: absolute; right: 0; bottom: 0; }
.active-portrait { position: absolute; left: 0; }
.ability-row { flex-direction: row; flex-shrink: 0; }
.heart-row { flex-shrink: 0; }
.hud-ability { position: relative; flex-shrink: 0; }
.hud-interaction-badges { position: absolute; left: -3px; top: -3px; flex-direction: row; }
.hud-interaction-badges > VisualElement { flex-shrink: 0; margin-right: 2px; }
.hud-face { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }
.hud-symbol, .hud-wipe { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-countdown { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; -unity-text-align: middle-center; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.hud-charges { position: absolute; color: white; margin: 0; padding: 0; -unity-text-align: upper-right; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.hud-prompt { position: absolute; align-items: center; justify-content: center; flex-shrink: 0; }
.hud-prompt Label { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; color: white; -unity-text-align: middle-center; }
.join-hint { position: absolute; color: rgb(225, 228, 235); -unity-text-align: middle-center; }
.selection-body { flex-shrink: 0; }
.preview-row { flex-direction: row; align-items: flex-start; flex-shrink: 0; background-color: rgba(9, 8, 17, 0.5); border-radius: 8px; }
.preview-copy { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; padding-left: 14px; padding-right: 12px; }
.preview-title, .preview-type, .preview-description { margin: 0; padding: 0; white-space: normal; }
.preview-type { color: rgb(202, 193, 213); margin-bottom: 5px; }
.preview-description { color: rgb(236, 231, 240); }
.highlight-name { -unity-text-align: middle-center; padding: 0; margin: 5px 0; }
.character-roster { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.hud-portrait { border-radius: 50%; overflow: hidden; }
.roster-portrait {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 1.5px;
    transition-property: scale;
    transition-timing-function: ease-out-back;
}
.selection-status { -unity-text-align: middle-center; color: rgb(206, 198, 214); padding: 0; margin: 0; }
.ability-inspect-hint { position: absolute; left: 0; top: 0; align-items: center; color: rgb(211, 202, 221); }
.inspect-key-badge { position: relative; border-width: 1px; border-color: rgb(230, 225, 216); border-radius: 5px; }
#inspect-caption { margin: 1px 0 0 0; padding: 0; -unity-text-align: middle-center; }
.ability-inspector { flex-shrink: 0; }
.ability-inspector Label { margin: 0; padding: 0; white-space: normal; }
.inspect-header { flex-direction: row; align-items: flex-start; }
.inspect-copy { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-left: 14px; }
.inspect-title-row { flex-direction: row; align-items: flex-start; margin-bottom: 10px; }
.inspect-title-copy { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.ability-inspect-type { color: rgb(206, 194, 215); }
.ability-inspect-stats { width: 144px; flex-shrink: 0; }
.ability-inspect-stat { flex-direction: row; align-items: flex-start; padding: 2px 5px; margin-bottom: 3px; border-radius: 4px; background-color: rgba(167, 150, 186, 0.1); }
.ability-inspect-stat-name { flex-grow: 1; flex-shrink: 1; color: rgb(213, 205, 224); }
.ability-inspect-stat-value { flex-shrink: 0; max-width: 68px; -unity-text-align: middle-right; }
.ability-inspect-description { color: rgb(238, 231, 241); }
.ability-inspect-marker { position: absolute; left: -3px; top: -3px; right: -3px; bottom: -3px; border-width: 1.5px; border-radius: 7px; }
