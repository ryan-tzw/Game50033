/* Main menu look: key art fills the screen, title top centre (in the open sky), options bottom left.
   Styled to match the gameplay HUD (Assets/Tuning/UI/GameplayHUD.asset): dark plum panels with 14px corners
   and thin borders, Alegreya fonts, lavender text, amber accent for the focused option.
   Focus and hover share one style so controller and mouse read the same. */
.menu-root {
    flex-grow: 1;
    background-color: rgb(11, 9, 17);
    background-image: url("/Assets/Art/UI/MainMenu/MainMenuKeyArt.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-font-definition: url("/Assets/Fonts/Alegreya_Sans/AlegreyaSans-Regular.ttf");
}

.menu-title {
    position: absolute;
    top: 50px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Fonts/Alegreya/Alegreya-Black.ttf");
    font-size: 150px;
    letter-spacing: 6px;
    color: rgb(255, 194, 84);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(11, 9, 17);
    text-shadow: 5px 6px 0 rgba(11, 9, 17, 0.85);
}

.menu-panel {
    position: absolute;
    left: 80px;
    bottom: 110px;
    align-items: flex-start;
}

.settings-panel {
    left: 510px;
    bottom: auto;
    top: 260px;
    width: 900px;
    align-items: center;
    padding: 24px;
    border-width: 1.4px;
    border-color: rgb(167, 150, 186);
    border-radius: 14px;
    background-color: rgba(11, 9, 17, 0.94);
}

.settings-title {
    -unity-font-definition: url("/Assets/Fonts/Alegreya/Alegreya-SemiBold.ttf");
    font-size: 48px;
    color: rgb(236, 231, 240);
    margin-bottom: 24px;
}

.menu-button {
    width: 420px;
    height: 72px;
    margin: 10px;
    -unity-font-definition: url("/Assets/Fonts/Alegreya/Alegreya-SemiBold.ttf");
    font-size: 36px;
    color: rgb(236, 231, 240);
    background-color: rgba(11, 9, 17, 0.94);
    border-width: 1.4px;
    border-color: rgb(167, 150, 186);
    border-radius: 14px;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgba(40, 30, 50, 0.96);
    border-width: 2.5px;
    border-color: rgb(255, 194, 84);
    color: rgb(255, 194, 84);
}

.menu-slider {
    width: 860px;
    margin: 12px;
    padding: 8px 16px;
    border-width: 1.4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 14px;
}

.menu-slider:focus,
.menu-slider:hover {
    border-color: rgb(255, 194, 84);
    background-color: rgba(167, 150, 186, 0.1);
}

.menu-slider > .unity-label {
    font-size: 32px;
    min-width: 300px;
    color: rgb(236, 231, 240);
}

.menu-slider:focus > .unity-label {
    color: rgb(255, 194, 84);
}

.menu-hint {
    position: absolute;
    left: 80px;
    bottom: 50px;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 24px;
    color: rgb(206, 198, 214);
    background-color: rgba(9, 8, 17, 0.75);
}
